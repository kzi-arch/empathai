# ─── Secrets — WAJIB ────────────────────────────────────────────────────────
# Berisi GEMINI_API_KEY. Bocor = kuota API Anda dipakai orang lain.
.env
.env.*
!.env.example

# Streamlit secrets (kalau nanti memakai st.secrets)
.streamlit/secrets.toml
*.pem
*.key

# ─── Data privat pengguna ───────────────────────────────────────────────────
# Percakapan tersimpan berisi curahan hati orang. Jangan pernah di-commit.
data/conversations/
data/conversations/*.json
!data/conversations/.gitkeep

# ─── Artefak yang bisa dibangun ulang ───────────────────────────────────────
# Vectorstore Chroma: ratusan MB, dan terikat pada model embedding.
# Ganti model = index harus dibangun ulang. Simpan di mesin, bukan di Git.
data/vectorstore/
data/vectorstore/**
!data/vectorstore/.gitkeep

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
MANIFEST
.eggs/

# ─── Virtualenv & conda ─────────────────────────────────────────────────────
.venv/
venv/
ENV/
env/
.conda/
conda-meta/

# ─── Cache tooling ──────────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# ─── Log & dump ─────────────────────────────────────────────────────────────
*.log
logs/
*.tmp
*.bak

# ─── Editor & OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ─── uv / lockfile opsional ─────────────────────────────────────────────────
